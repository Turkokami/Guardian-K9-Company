---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnswerBox from '../components/AnswerBox.astro';
import TrustStrip from '../components/TrustStrip.astro';
import TeamBlock from '../components/TeamBlock.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import MdBody from '../components/MdBody.astro';
import { services } from '../data/services';
import { buildableVerticals } from '../data/verticals';
import { cities, areaOnlyCities, orderedCounties, PRIME_COUNTIES } from '../data/cities';
import { business } from '../data/business';
import { publicAssetExists } from '../lib/assets';
import { resolve } from '../lib/body';

const route = '/';
/** M7 — the brand banner across the top, guarded on the file existing (B-11). */
const banner = publicAssetExists(business.banner) ? business.banner : null;
const bannerSrcset = business.bannerWidths
  .map(w => `/img/guardian-k9-banner-${w}.jpg ${w}w`)
  .join(', ');
const counties = orderedCounties();
const isPrime = (county: string) => (PRIME_COUNTIES as readonly string[]).includes(county);
const answer = 'Guardian K9 Company provides independent canine bed bug detection and K9 Canada goose deterrent programs across Washington State. We do not apply pesticides and we do not sell treatment, so our findings have nothing to steer. Every alert is visually confirmed before it appears in your written, dated report.';
const faqs = [
  { q: 'Do you treat bed bugs?', a: 'No. Guardian is a detection-only business. We apply no pesticides and sell no treatment, which is precisely why our report has no commercial direction to lean in. If we find something, you engage a licensed applicator of your choosing.' },
  { q: 'What do I actually receive?', a: 'A dated, signed report mapping every location the dog alerted on, the visual confirmation result for each alert, photographs of confirmed findings, and a written all-clear where nothing was found.' },
  { q: 'How accurate is canine detection?', a: 'There are two honest numbers and they measure different things. We publish both, with links to the peer-reviewed sources, on our detection accuracy page rather than quoting a single marketing figure.' },
  { q: 'What areas do you serve?', a: 'All of Washington State, worked from a Northern Washington base. Whatcom and Skagit counties are the prime work zones and carry the bulk of the schedule; everywhere else is booked in advance rather than same-day.' },
  { q: 'Do you work with property managers?', a: 'Multifamily property management is our primary commercial program. We run unit-by-unit and building-wide sweeps and produce the documentation that resolves responsibility questions.' },
  { q: 'Is the goose work legal?', a: 'Handler-directed hazing with no contact and no injury is a non-lethal method Washington Department of Fish and Wildlife names as the method of choice for large open areas. We never disturb nests or eggs.' },
];
const r = await resolve(route, { answer, faqs });
---
<BaseLayout
  title="Independent K9 Bed Bug Detection | Washington State"
  description="Independent canine bed bug detection and K9 goose deterrent programs for multifamily and commercial properties across Washington. We detect; we never sell treatment."
  path={route}
  faqs={r.faqs}
  draft={r.draft}
  dateModified={r.dateModified}
  pageType={{ kind: 'service', serviceType: 'Canine detection services', areaServed: ['Washington'] }}
>
  {banner && (
    <section class="banner">
      <img
        src={banner}
        srcset={bannerSrcset}
        sizes="100vw"
        width="1920" height="768"
        alt="Guardian K9 Company badge set against Cascade mountains and evergreen forest"
        fetchpriority="high" decoding="async"
      />
    </section>
  )}

  <section class="hero">
    <div class="wrap">
      <h1>An inspection with nothing to sell you</h1>
      <p class="lede">
        Canine bed bug detection and K9 goose deterrent programs for multifamily housing and
        commercial facilities across Washington State. We apply no pesticides and sell no
        treatment — so what the dog finds is the only thing driving the report.
      </p>
      <p><a class="btn" href="/contact/">Request an inspection</a></p>
    </div>
  </section>

  <div class="wrap">
    <TrustStrip />
    <AnswerBox answer={r.answer} />

    <h2>What we do</h2>
    <div class="card-grid">
      {services.map(s => (
        <a class="card" href={`/services/${s.slug}/`}>
          <span class="card-kicker">{s.family === 'goose' ? 'Grounds programs' : 'Bed bug detection'}</span>
          <h3>{s.name}</h3>
          <p>{s.blurb}</p>
          <span class="card-go">Read more</span>
        </a>
      ))}
    </div>

    <h2>Who we do it for</h2>
    <div class="card-grid card-grid-tight">
      {buildableVerticals.map(v => (
        <a class="card" href={`/commercial/${v.slug}/`}>
          <h3>{v.name}</h3>
          <p>{v.audience}</p>
          <span class="card-go">See the programme</span>
        </a>
      ))}
    </div>

    <h2>Where we work</h2>
    <p class="geo-lede">
      Whatcom and Skagit are the prime work zones and carry the bulk of the schedule.
      Everywhere else in Washington is booked in advance rather than same-day.
    </p>
    <div class="geo">
      {counties.map(county => (
        <section class={`geo-group${isPrime(county) ? ' is-prime' : ''}`}>
          <h3>
            {county} County
            {isPrime(county) && <span class="tag-prime">Prime</span>}
          </h3>
          <ul class="chips">
            {cities.filter(c => c.county === county && c.cluster !== 'area').map(c => (
              <li><a class="chip" href={`/service-area/${c.slug}/`}>{c.name}</a></li>
            ))}
            {areaOnlyCities.filter(c => c.county === county).map(c => (
              <li><span class="chip chip-static" title="Covered, no page of its own">{c.name}</span></li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <TeamBlock />

    <h2>Why independence is the product</h2>
    <p>
      When the company that inspects your property is also the company that sells you the
      treatment, the inspection has a built-in incentive to find work. Guardian cannot sell you a
      treatment, so there is nothing for our findings to lean toward.
      <a href="/independent-detection/">Read why that matters →</a>
    </p>

    <MdBody entry={r.body} />
    <Faq faqs={r.faqs} />
  </div>
  <Cta heading="Book an inspection" body="Tell us the property type and unit count and we'll scope it." />
</BaseLayout>
