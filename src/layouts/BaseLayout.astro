---
/**
 * BaseLayout — head, meta, OG/Twitter, and the SINGLE schema injection point.
 * No page emits inline JSON-LD. One emitter, always (plan 5.4).
 */
import '../styles/global.css';
import { business } from '../data/business';
import { buildGraph, type Breadcrumb, type Faq } from '../lib/schema';
import { buildTitle, buildDescription } from '../lib/seo';
import { publicAssetExists } from '../lib/assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PhoneBar from '../components/PhoneBar.astro';

export interface Props {
  title: string;
  description: string;
  path: string;
  breadcrumbs?: Breadcrumb[];
  faqs?: Faq[];
  image?: string;
  dateModified?: string;
  pageType?: Parameters<typeof buildGraph>[0]['pageType'];
  /** True when the page has not yet met the M1 word floor. Renders noindex + a draft banner. */
  draft?: boolean;
}

const {
  title, description, path,
  breadcrumbs = [{ name: 'Home', path: '/' }],
  faqs, image, dateModified, pageType, draft = false,
} = Astro.props;

const t = buildTitle(title);
const d = buildDescription(description);
const canonical = `${business.siteUrl}${path}`;

/**
 * M7 — every page carries a social image, and harness check 2 requires the tag to exist on
 * every page, so this always resolves to a URL. It prefers the first candidate actually on
 * disk (page image, then the shared social image, then the logo) and only falls back to the
 * declared social image path when none of them are there yet (B-11). The tag never
 * disappears; it just starts pointing at a real file the moment one lands.
 */
const ogCandidate =
  [image, business.socialImage, business.logo].find(publicAssetExists) ??
  image ??
  business.socialImage;
const ogImage = `${business.siteUrl}${ogCandidate}`;

const graph = buildGraph({
  path, title: t, description: d, image, breadcrumbs, faqs, dateModified, pageType,
});
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{t}</title>
  <meta name="description" content={d} />
  <link rel="canonical" href={canonical} />
  {draft && <meta name="robots" content="noindex,nofollow" />}

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={business.name} />
  <meta property="og:title" content={t} />
  <meta property="og:description" content={d} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={t} />
  <meta name="twitter:description" content={d} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Single JSON-LD emitter. set:html on a REAL script element — never a pseudo-element
       (double-escaping renders the graph as visible text). Verified by scripts/schema-validate.mjs -->
  <script type="application/ld+json" set:html={JSON.stringify(graph)} />
</head>
<body>
  <Header />
  <main>
    {draft && (
      <div class="wrap">
        <p class="draft-banner">
          <strong>Draft — not indexed.</strong> This page has not yet met the M1 depth floor
          (3,000–5,000 words of unique, researched local content). It is excluded from the sitemap
          and marked <code>noindex</code> until it does. A thin page is worse than no page.
        </p>
      </div>
    )}
    <slot />
  </main>
  <Footer />
  <PhoneBar />
</body>
</html>
