---
import { business } from '../data/business';
import { publicAssetExists } from '../lib/assets';

/**
 * M7 — the brand mark appears on every page. Guarded on the file actually existing so a
 * missing asset renders as the wordmark alone rather than as a broken image (B-11).
 * M6 — a logo's alt text is the business name, nothing else.
 */
const mark = publicAssetExists(business.logoMark) ? business.logoMark : business.logo;
const hasLogo = publicAssetExists(mark);
---
<header class="site-header">
  <div class="wrap">
    <nav aria-label="Primary">
      <a class="brand" href="/">
        {hasLogo && (
          <img src={mark} alt={business.name} width="38" height="38" decoding="async" />
        )}
        <span>{business.name}</span>
      </a>
      <a href="/services/">Services</a>
      <a href="/commercial/">Commercial</a>
      <a href="/service-area/">Service Area</a>
      <a href="/detection-accuracy/">Accuracy</a>
      <a href="/independent-detection/">Independent</a>
      <a href="/lindsey-elling/">About</a>
      <a class="btn" href="/contact/">Request an Inspection</a>
    </nav>
  </div>
</header>
