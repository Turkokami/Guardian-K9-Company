---
/** Renders from the SAME array that feeds the FAQPage node. Exactly one block per URL. */
import type { Faq } from '../lib/schema';
export interface Props { faqs: Faq[]; heading?: string }
const { faqs, heading = 'Frequently asked questions' } = Astro.props;
---
{faqs.length > 0 && (
  <section class="faq faq-speakable">
    <h2>{heading}</h2>
    {faqs.map(f => (
      <details>
        <summary>{f.q}</summary>
        <div class="a">{f.a}</div>
      </details>
    ))}
  </section>
)}
